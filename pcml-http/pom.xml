<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.generativearchitects.slay400</groupId>
    <artifactId>slay400-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pcml-http</artifactId>
  <name>pcml-http</name>
  <description>The HTTP binding of an API, without a web framework: routes, reading a request into API values, writing the JSON response and the problem-details body.</description>

  <properties>
    <!-- Decision 63: a higher mutation threshold where an undetected fault costs most (kickoff 13). -->
    <mutation.threshold>95</mutation.threshold>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-model</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-codec</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-emit-descriptor</artifactId>
    </dependency>

    <!-- Test scope only: the fixtures of kickoff 02, the OpenAPI document that the binding must agree with, the schema validator
         that checks it, the mock that answers, and the in-house generator of the codec tests. -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-codec</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-validation</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-emit-openapi</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-mock</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
