<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.generativearchitects.slay400</groupId>
    <artifactId>slay400-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pcml-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>pcml-maven-plugin</name>
  <description>Maven plugin, goal prefix pcml: validate, generate, bundle and diff a repository of APIs as part of a build.</description>

  <!-- The lowest Maven the plugin is built and tested with: the one of the Maven Wrapper of this repository. -->
  <prerequisites>
    <maven>${maven.api.version}</maven>
  </prerequisites>

  <properties>
    <!-- Apache-2.0. The API of the lowest Maven version the plugin runs on; Maven provides it at run time. -->
    <maven.api.version>3.9.9</maven.api.version>
    <!-- Apache-2.0. Annotations and the generator of the plugin descriptor. -->
    <maven-plugin-tools.version>3.16.0</maven-plugin-tools.version>
    <!-- Apache-2.0. Runs the integration builds in src/it. -->
    <maven-invoker-plugin.version>3.10.1</maven-invoker-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-tasks</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-report</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-model</artifactId>
    </dependency>

    <!-- Maven's own artifacts: provided by Maven, never bundled into an artifact of this repository. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Apache-2.0, JSR 330 (version 1, 2010): how Maven 3 injects the project helper into a goal. -->
    <dependency>
      <groupId>javax.inject</groupId>
      <artifactId>javax.inject</artifactId>
      <version>1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Test scope only: the fixture repositories of kickoff 02 and 09. -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The integration builds: each folder of src/it is a small project that runs the plugin from a local repository that this
        build fills (target/local-repo), then a script checks the files and the log. Needs the command-line jar, so the module
        comes after pcml-cli in the reactor.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>${maven-invoker-plugin.version}</version>
        <configuration>
          <projectsDirectory>src/it</projectsDirectory>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
          <pomIncludes>
            <pomInclude>*/pom.xml</pomInclude>
          </pomIncludes>
          <postBuildHookScript>verify</postBuildHookScript>
          <preBuildHookScript>setup</preBuildHookScript>
          <scriptVariables>
            <cliJar>${project.basedir}/../pcml-cli/target/pcml-cli-${project.version}.jar</cliJar>
          </scriptVariables>
          <streamLogsOnFailures>true</streamLogsOnFailures>
          <addTestClassPath>false</addTestClassPath>
        </configuration>
        <executions>
          <execution>
            <id>integration-test</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin-tools.version}</version>
        <configuration>
          <goalPrefix>pcml</goalPrefix>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
