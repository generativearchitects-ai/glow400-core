  </parent>

  <artifactId>pcml-diff</artifactId>
  <name>pcml-diff</name>
  <description>Breaking-change detection between a released and a current repository.</description>

  <properties>
    <!-- Decision 63: a higher mutation threshold where an undetected fault costs most. -->
    <mutation.threshold>95</mutation.threshold>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-model</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-contract</artifactId>
    </dependency>

    <!-- Test scope only: fixtures, and the descriptor reader and writer for the released side. -->
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-emit-descriptor</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-codec</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
