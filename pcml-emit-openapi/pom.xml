<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.generativearchitects.glow400</groupId>
    <artifactId>glow400-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pcml-emit-openapi</artifactId>
  <name>pcml-emit-openapi</name>
  <description>Writes one OpenAPI 3.1 document per API.</description>

  <dependencies>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-model</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-contract</artifactId>
    </dependency>

    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-validation</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-codec</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test scope only: the YAML library of pcml-overlay reads every emitted document back. -->
    <dependency>
      <groupId>org.snakeyaml</groupId>
      <artifactId>snakeyaml-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test scope only: validates the emitted documents against the official OpenAPI 3.1 JSON Schema. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-emit-descriptor</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
