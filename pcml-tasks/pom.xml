<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.generativearchitects.slay400</groupId>
    <artifactId>slay400-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pcml-tasks</artifactId>
  <name>pcml-tasks</name>
  <description>The pipeline tasks (validate, generate, bundle, diff) that the command-line tool and the Maven plugin share. Knows nothing about command lines, Maven, standard streams or exit codes.</description>

  <dependencies>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-model</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-validation</artifactId>
    </dependency>
    <!-- The emitters are found with ServiceLoader: they must be on the class path of whoever runs a task. -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-emit-descriptor</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-emit-openapi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-mock</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-bundle</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-diff</artifactId>
    </dependency>
    <!-- TextReport.escape: names from the repository are escaped in every message. -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-report</artifactId>
    </dependency>

    <!-- Test scope only: the fixtures of kickoff 02 and 09. -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-bundle</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
