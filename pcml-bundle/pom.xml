<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.generativearchitects.glow400</groupId>
    <artifactId>glow400-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pcml-bundle</artifactId>
  <name>pcml-bundle</name>
  <description>Packs the outputs of a repository into one versioned, verifiable bundle (.rpgapi), and reads it back as untrusted input.</description>

  <dependencies>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-model</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-emit-descriptor</artifactId>
    </dependency>

    <!-- Test scope only: the fixtures, the emitters and the codec, for the round trips. -->
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-validation</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-codec</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-codec</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.glow400</groupId>
      <artifactId>pcml-emit-openapi</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>
</project>
