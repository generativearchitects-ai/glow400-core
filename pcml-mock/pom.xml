<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.generativearchitects.slay400</groupId>
    <artifactId>slay400-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pcml-mock</artifactId>
  <name>pcml-mock</name>
  <description>Mock definitions: the evaluator that stands in for a program call, the mock emitter and the reader of its file.</description>

  <properties>
    <!-- Kickoff 09: a mock must never answer in a way the real call could not. -->
    <mutation.threshold>95</mutation.threshold>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-model</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-codec</artifactId>
    </dependency>
    <!-- Json: the writer and the bounded reader of the descriptor, used for mock/<api>.json too. -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-emit-descriptor</artifactId>
    </dependency>

    <!-- The reader names JsonProcessingException to say where in the document a problem is. Already used by pcml-emit-descriptor. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>

    <!-- Test scope only: the fixtures of kickoff 02, validation of the fixtures' mocks, and the in-house generator. -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-overlay</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-validation</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-codec</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
